# Auto detect text files and perform LF normalization
* text=auto

# Force LF line endings for these files
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf

# Prisma schema files
*.prisma text eol=lf

# Shell scripts
*.sh text eol=lf

# Config files
.prettierrc text eol=lf
.eslintrc* text eol=lf
tsconfig.json text eol=lf
package.json text eol=lf
