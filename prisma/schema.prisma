// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model
enum Sex {
  MALE
  FEMALE
}

model User {
  id             Int              @id @default(autoincrement())
  first_name     String
  last_name      String
  password       String
  email          String           @unique
  role           Role
  status         Boolean          @default(true)
  phone_number   String?
  sex            Sex?
  email_verified        Boolean   @default(false)
  verification_token    String?   @unique
  verification_token_expires DateTime?
  reset_token          String?   @unique
  reset_token_expires  DateTime?
  created_at     DateTime         @default(now())
  // NextAuth fields preserved
  image          String?
  accounts       Account[]
  sessions       Session[]
  
  // Relations
  platforms      PlatformService[]
  freelance      Freelance?
  ownedCompany   Company?         @relation("CompanyAdmin")
  managedCompanies CompanyManager[] @relation("CompanyManagers")

  @@map("users")
}

enum Role {
  ADMIN
  COMPANY
  FREELANCE
  MANAGER
}

// Freelance model
model Freelance {
  id           Int               @id @default(autoincrement())
  freelance_id Int               @unique
  secteur_activite_id    Int
  secteurActivite       SecteurActivite            @relation(fields: [secteur_activite_id], references: [id])
  user         User              @relation(fields: [freelance_id], references: [id])
  requests     FreelanceRequest[]

  @@map("freelances")
}

// Company model
model Company {
  id                Int             @id @default(autoincrement())
  admin_user_id     Int             @unique
  name              String
  description       String?         @db.Text
  logo              String?         @db.Text
  siret             String?         @unique
  consultant_count  Int
  management_fees   Float?
  is_portage        Boolean         @default(false)
  date_creation     DateTime?
  chiffre_affaires  Decimal?
  adresse           String?         @db.Text
  site_web          String?
  convention_collective String?
  code_naf_ape      String?
  admin             User            @relation("CompanyAdmin", fields: [admin_user_id], references: [id])
  managers          CompanyManager[]
  services          CompanyService[]
  responses         CompanyResponse[]
  secteurActivites  SecteurActiviteCompany[]
  labels            CompanyLabel[]
  organismes        Organisme[]

  @@map("companies")
}

// CompanyManager model
model CompanyManager {
  id          Int      @id @default(autoincrement())
  company_id  Int
  user_id     Int
  company     Company  @relation(fields: [company_id], references: [id])
  user        User     @relation("CompanyManagers", fields: [user_id], references: [id])
  
  @@unique([company_id, user_id])
  @@map("company_managers")
}

// SecteurActiviteCompany junction table for many-to-many relationship (renamed from CompanyMetier)
model SecteurActiviteCompany {
  id          Int      @id @default(autoincrement())
  company_id  Int
  secteur_activite_id   Int
  company     Company  @relation(fields: [company_id], references: [id])
  secteurActivite      SecteurActivite   @relation(fields: [secteur_activite_id], references: [id])
  
  @@unique([company_id, secteur_activite_id])
  @@map("secteur_activite_companies")
}

// CompanyLabel junction table for many-to-many relationship (renamed from CompanyPortage)
model CompanyLabel {
  id          Int      @id @default(autoincrement())
  company_id  Int
  label_syndicat_id  Int
  company     Company  @relation(fields: [company_id], references: [id])
  labelSyndicat     LabelSyndicat  @relation(fields: [label_syndicat_id], references: [id])
  
  @@unique([company_id, label_syndicat_id])
  @@map("company_labels")
}
// platform service
model PlatformService {
  id                Int                     @id @default(autoincrement())
  user_id           Int
  label             String
  description       String?                 @db.Text
  requires_data     Boolean                 @default(false)
  status            ServiceStatus
  user              User                    @relation(fields: [user_id], references: [id])
  companyServices   CompanyService[]
  freelanceRequests FreelanceRequestOption[]
  dataFields        PlatformServiceData[]

  @@map("platform_services")
}
// platform service data
model PlatformServiceData {
  id                 Int             @id @default(autoincrement())
  platformServiceId  Int
  label              String
  description        String?         @db.Text
  data_type          DataType
  choices            Json?
  platformService    PlatformService @relation(fields: [platformServiceId], references: [id])

  @@map("platform_service_data")
}
enum DataType {
  TEXT
  NUMBER
  SELECT
  RADIO
}

enum ServiceStatus {
  ACTIVE
  INACTIVE
  PENDING
}

// CompanyService model
model CompanyService {
  id              Int                    @id @default(autoincrement())
  company_id      Int
  service_id      Int
  is_active       Boolean
  company         Company                @relation(fields: [company_id], references: [id])
  service         PlatformService        @relation(fields: [service_id], references: [id])

  @@map("company_services")
}

// FreelanceRequest model
model FreelanceRequest {
  id              Int                    @id @default(autoincrement())
  freelance_id    Int
  mission_status  MissionStatus
  client_name     String?
  client_address  String?
  client_sector   String?
  priority        Priority
  tjm             Float
  want_salaried   Boolean                @default(false)
  salary          Float?
  start_date      DateTime?
  days            Float
  wants_portage   Boolean                @default(false)
  created_at     DateTime         @default(now())
  freelance       Freelance              @relation(fields: [freelance_id], references: [id])
  options         FreelanceRequestOption[]
  responses       CompanyResponse[]
  requestLabelsSelected RequestLabelSelected[]

  @@map("freelance_requests")
}

enum MissionStatus {
  OPEN
  CLOSED
  PENDING
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

// FreelanceRequestOption model
model FreelanceRequestOption {
  id                  Int             @id @default(autoincrement())
  freelance_request_id Int
  service_option_id   Int
  is_required      Boolean         @default(false)
  response_data    Json?
  request             FreelanceRequest @relation(fields: [freelance_request_id], references: [id])
  platformService     PlatformService @relation(fields: [service_option_id], references: [id])

  @@map("freelance_request_options")
}

// RequestLabelSelected junction table for freelance label preferences (renamed from FreelanceRequestPortage)
model RequestLabelSelected {
  id                  Int             @id @default(autoincrement())
  freelance_request_id Int
  label_syndicat_id          Int
  request             FreelanceRequest @relation(fields: [freelance_request_id], references: [id])
  labelSyndicat             LabelSyndicat         @relation(fields: [label_syndicat_id], references: [id])
  
  @@unique([freelance_request_id, label_syndicat_id])
  @@map("request_labels_selected")
}

// CompanyResponse model
model CompanyResponse {
  id                  Int             @id @default(autoincrement())
  request_id          Int
  company_id          Int
  response_data       Json            // Contains all services responses and other data
  created_at         DateTime        @default(now())
  updated_at         DateTime        @updatedAt
  request             FreelanceRequest @relation(fields: [request_id], references: [id])
  company             Company         @relation(fields: [company_id], references: [id])
  organismes          CompanyResponseOrganisme[]

  // Ensure one response per company per request
  @@unique([request_id, company_id])
  @@map("company_responses")
}

model CompanyResponseOrganisme {
  id                  Int         @id @default(autoincrement())
  company_response_id Int
  organisme_id        Int
  additional_data     Json?       // store extra info like cotisation details
  
  companyResponse     CompanyResponse @relation(fields: [company_response_id], references: [id])
  organisme           Organisme       @relation(fields: [organisme_id], references: [id])

  @@map("company_response_organismes")
}
// NextAuth models preserved as-is
model Account {
  id                String  @id @default(cuid())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       Int
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// SecteurActivite model (renamed from Metier)
model SecteurActivite {
  id          Int             @id @default(autoincrement())
  code        String          @unique
  name        String          @unique
  freelances  Freelance[]
  companies   SecteurActiviteCompany[]
  
  @@map("secteur_activites")
}

// LabelSyndicat model (renamed from Portage)
model LabelSyndicat {
  id          Int             @id @default(autoincrement())
  name        String          @unique
  description String?         @db.Text
  logo        String?
  companies   CompanyLabel[]
  freelanceRequests RequestLabelSelected[]
  
  @@map("label_syndicats")
}

model Organisme {
  id          Int      @id @default(autoincrement())
  company_id  Int
  label       String
  description String?  @db.Text
  company     Company  @relation(fields: [company_id], references: [id])

  cotisations Cotisation[]
  companyResponseOrganismes CompanyResponseOrganisme[]

  @@map("organismes")
}

enum CotisationType {
  PATRONAL
  SALARIAL
  DEUX
}

model Cotisation {
  id                    Int            @id @default(autoincrement())
  organisme_id          Int
  label                 String
  description           String?        @db.Text
  type                  CotisationType
  pourcentage_salarial  Float?
  pourcentage_patronal  Float?
  organisme             Organisme      @relation(fields: [organisme_id], references: [id])

  @@map("cotisations")
}