// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model
model User {
  id             Int              @id @default(autoincrement())
  first_name     String
  last_name      String
  password       String
  email          String           @unique
  role           Role
  status         Boolean          @default(true)
  phone_number   String?
  // NextAuth fields preserved
  image          String?
  accounts       Account[]
  sessions       Session[]
  
  // Relations
  platforms      PlatformService[]
  freelance      Freelance?
  ownedCompany   Company?         @relation("CompanyAdmin")
  managedCompanies CompanyManager[] @relation("CompanyManagers")

  @@map("users")
}

enum Role {
  ADMIN
  COMPANY
  FREELANCE
  MANAGER
}

// Freelance model
model Freelance {
  id           Int               @id @default(autoincrement())
  freelance_id Int               @unique
  metier       String
  user         User              @relation(fields: [freelance_id], references: [id])
  requests     FreelanceRequest[]

  @@map("freelances")
}

// Company model
model Company {
  id                Int             @id @default(autoincrement())
  admin_user_id     Int             @unique
  name              String
  description       String?         @db.Text
  logo              String?         @db.Text
  siret             Int
  consultant_count  Int
  management_fees   Float
  admin             User            @relation("CompanyAdmin", fields: [admin_user_id], references: [id])
  managers          CompanyManager[]
  services          CompanyService[]
  responses         CompanyResponse[]

  @@map("companies")
}

// CompanyManager model
model CompanyManager {
  id          Int      @id @default(autoincrement())
  company_id  Int
  user_id     Int
  company     Company  @relation(fields: [company_id], references: [id])
  user        User     @relation("CompanyManagers", fields: [user_id], references: [id])
  
  @@unique([company_id, user_id])
  @@map("company_managers")
}

// PlatformService model
model PlatformService {
  id               Int             @id @default(autoincrement())
  user_id          Int
  label            String
  description      String?         @db.Text
  data_type        DataType
  requires_data  Boolean         @default(false)
  data_label       String
  data_description String?         @db.Text
  choices          Json?
  status           ServiceStatus
  user             User            @relation(fields: [user_id], references: [id])
  companyServices  CompanyService[]
  companyResponses CompanyResponse[]

  @@map("platform_services")
}

enum DataType {
  TEXT
  NUMBER
  SELECT
  RADIO
}

enum ServiceStatus {
  ACTIVE
  INACTIVE
  PENDING
}

// CompanyService model
model CompanyService {
  id              Int                    @id @default(autoincrement())
  company_id      Int
  service_id      Int
  is_active       Boolean
  company         Company                @relation(fields: [company_id], references: [id])
  service         PlatformService        @relation(fields: [service_id], references: [id])
  requestOptions  FreelanceRequestOption[]

  @@map("company_services")
}

// FreelanceRequest model
model FreelanceRequest {
  id              Int                    @id @default(autoincrement())
  freelance_id    Int
  mission_status  MissionStatus
  client_name     String?
  client_address  String?
  client_sector   String?
  priority        Priority
  tjm             Float
  days            Float
  freelance       Freelance              @relation(fields: [freelance_id], references: [id])
  options         FreelanceRequestOption[]
  responses       CompanyResponse[]

  @@map("freelance_requests")
}

enum MissionStatus {
  OPEN
  CLOSED
  PENDING
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

// FreelanceRequestOption model
model FreelanceRequestOption {
  id                  Int             @id @default(autoincrement())
  freelance_request_id Int
  service_option_id   Int
  is_required      Boolean         @default(false)
  request             FreelanceRequest @relation(fields: [freelance_request_id], references: [id])
  serviceOption       CompanyService   @relation(fields: [service_option_id], references: [id])

  @@map("freelance_request_options")
}

// CompanyResponse model
model CompanyResponse {
  id                  Int             @id @default(autoincrement())
  request_id          Int
  company_id          Int
  platform_service_id Int
  management_fees     Float
  response_data       Json
  request             FreelanceRequest @relation(fields: [request_id], references: [id])
  company             Company         @relation(fields: [company_id], references: [id])
  platformService     PlatformService @relation(fields: [platform_service_id], references: [id])

  @@map("company_responses")
}

// NextAuth models preserved as-is
model Account {
  id                String  @id @default(cuid())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       Int
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}