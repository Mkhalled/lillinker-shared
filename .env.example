# Database Configuration
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=your_db_name
POSTGRES_PORT=5432
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key" # Generate a secure secret key

# Email Service (for verification)
# These will be configured when we set up the email service
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT=""
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM=""

# Development
NODE_ENV="development"

# 🛠️ Logging Configuration
# ------------------------
# Environment mode (development/production)
# - development: Colored, human-readable logs
# - production: JSON-formatted logs for better parsing
NODE_ENV=development

# Enable file-based logging
# - true: Logs will be written to files
# - false: Logs will only be written to console
# Note: Always true in production environment
LOG_TO_FILE=true

# Minimum log level to output
# Available levels (in order of importance):
# - error: Critical errors and exceptions
# - warn: Warning conditions
# - info: General operational information
# - http: HTTP request logging
# - debug: Detailed debugging information
LOG_LEVEL=debug

# Log file configuration
# ---------------------
# Maximum size of each log file before rotation
LOG_MAX_SIZE=20m

# Number of days to keep rotated log files
LOG_MAX_DAYS=14

# Log file paths
# -------------
# Error log file path
LOG_ERROR_FILE=logs/error.log

# Combined log file path
LOG_COMBINED_FILE=logs/lillinker.log

# Daily rotated log file patterns
LOG_ERROR_ROTATE_PATTERN=logs/error-%DATE%.log
LOG_COMBINED_ROTATE_PATTERN=logs/combined-%DATE%.log